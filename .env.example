CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# RAG Embedding Provider (openai or huggingface)
RAG_EMBEDDING_PROVIDER=huggingface

# LangSmith Observability (https://smith.langchain.com)
# Used for tracing and python -m evals.grounding
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-rag-chat-dev

# Eval harness (optional; defaults shown)
# EVAL_PROVIDER=openai
# EVAL_MODEL=gpt-4o-mini

# Shared secret so only the Next.js service can call the Python API.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk -> JWT Templates -> Convex issuer domain
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/