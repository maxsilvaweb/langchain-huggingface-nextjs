# Example .env file for the Python service
# Copy this to .env and fill in the values

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# AI Providers
HUGGINGFACE_API_KEY=hf_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# LangSmith Observability (free tier: https://smith.langchain.com)
# Enables automatic tracing of all LangChain calls
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=langchain-rag-chat

# RAG Configuration (optional)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding provider: 'huggingface' (default) or 'openai'
# Switch to 'openai' if HuggingFace credits are depleted.
# OpenAI uses text-embedding-3-small with 384 dimensions (matches Convex schema).
# NOTE: After switching, re-ingest all documents with the new provider.
RAG_EMBEDDING_PROVIDER=huggingface
